# =============================================================================
#  Application environment.                   cp app.env.example app.env
# -----------------------------------------------------------------------------
#  Mounted read-only at /app/.env inside every application container, AND read
#  by compose for interpolation — which is the whole point of the arrangement.
#
#  The postgres and redis services are created from the DB_* and REDIS_* values
#  BELOW, the same values the application later logs in with. One secret, one
#  file. The alternative — a copy of DB_PASSWORD in .env for compose and
#  another here for the app — is two values free to drift, and a drift between
#  them presents as an authentication failure against a file that looks right.
#
#  This is a PRODUCTION file. Do not commit it; .gitignore already covers it.
#  Keys not listed here are documented in the application repository's own
#  .env.example — this file carries the ones the stack itself depends on.
# =============================================================================

APP_NAME="RayanSolve"
APP_ENV=production
# php artisan key:generate --show   (or: make key)
# Losing this key makes every encrypted column and every existing session
# unreadable. It belongs in your password manager as well as here.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Dhaka"
APP_URL=https://otc.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
# Matched to the files backup schedule: 14 days of dailies is what a weekly
# files backup can actually recover.
LOG_DAILY_DAYS=14

# -----------------------------------------------------------------------------
#  DATABASE  —  these three create the postgres container on first start
# -----------------------------------------------------------------------------
#  DB_HOST must be the compose SERVICE NAME. Inside the project network that is
#  the hostname; 127.0.0.1 is the container's own loopback and reaches nothing.
#  preflight.sh asserts this rather than letting it time out.
#
#  POSTGRES_* are read by the image's initdb ONLY when the data directory is
#  empty, and ignored forever after. Changing DB_PASSWORD here does NOT change
#  the role's password on an existing cluster — `make db-password` does that.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=otc_server
DB_USERNAME=otc_server
# openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 28
DB_PASSWORD=

# -----------------------------------------------------------------------------
#  REDIS  —  one instance, four logical databases
# -----------------------------------------------------------------------------
#  0 queues, sessions, locks   1 general cache   2 products L1
#  Sharing one instance is why the eviction policy must stay volatile-lru; see
#  the note in .env and in config/redis/redis.conf.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
#  Telescope — must stay off in production
# -----------------------------------------------------------------------------
#  It records every request, query and job into the database. On a production
#  instance that is both a disk-growth problem and an exposure of request
#  payloads. The image excludes it; this is the belt to that pair of braces.
TELESCOPE_ENABLED=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
#  In-application backups
# -----------------------------------------------------------------------------
#  Leave BACKUP_PATH alone: it is the container side of the bind mount that
#  BACKUP_DIR in .env names on the host. Both must point at the same place or
#  an in-app backup lands in the container's writable layer and disappears
#  with the container.
#
#  Scheduling and retention are handled on the HOST by this repository
#  (`make cron-install`), not by the application.
BACKUP_PATH=/var/backups/otc

ENABLE_PRODUCT_CACHE=true
PRODUCT_ENCRYPT_ID=true
OTC_INSTANCE_KEY=
