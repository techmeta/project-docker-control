# =============================================================================
#  Docker control plane for the OTC stack.          cp .env.example .env
# -----------------------------------------------------------------------------
#  This file configures DOCKER: which package to pull, where host state lives,
#  how much RAM and disk the stack may use, and when the backup cron runs.
#
#  It is NOT the application environment. That is config/app.env — APP_KEY,
#  DB_*, REDIS_*, API credentials. Both files are passed to compose (see the
#  COMPOSE_ENV note in the Makefile) and the split is deliberate: everything
#  here ends up in `docker compose config` and in process listings, so no
#  application secret may live in it.
#
#  This repository BUILDS NOTHING. It pulls a published image and runs it.
#  The source tree that produces that image lives elsewhere.
# =============================================================================

# Compose project name. Every container, and the network, is prefixed with it.
# Change it only if you run two copies of this stack on one host — and if you
# do, change the published ports below too, or the second `up` fails on a
# port collision.
STACK_NAME=otc

# dev | staging | production. Read by the scripts that refuse to run in the
# wrong place: `make restore` warns outside production, `make cron-install`
# refuses anywhere but production (a laptop that sleeps runs no backups but
# reports success).
DEPLOY_ENV=production

TZ=Asia/Dhaka

# unless-stopped, not always: `docker stop` during maintenance must stay
# stopped across a daemon restart. `always` brings the stack back up under an
# operator who deliberately took it down.
RESTART_POLICY=unless-stopped

# -----------------------------------------------------------------------------
#  THE PACKAGE  —  what `make pull` and `make deploy` fetch
# -----------------------------------------------------------------------------
#  A GitHub Container Registry package path. ghcr.io wants the OWNER in
#  lowercase, always, even when the GitHub account is capitalised — a mixed
#  case path fails with an unhelpful "denied" that reads like an auth error.
#
#  Docker Hub works identically: set REGISTRY=docker.io and APP_IMAGE to
#  docker.io/techmeta/otc-server-app.
APP_IMAGE=ghcr.io/techmeta/otc-server-app

# NEVER `latest` on a server. A host running a floating tag cannot tell you
# what it is running, two hosts pulling "the same" tag can differ, and there
# is nothing to roll back TO. Use the immutable sha-<short> tag the build
# publishes, or a release tag.
#
# `make deploy TAG=sha-1a79309` rewrites this line, so the file always records
# what is actually running.
APP_TAG=sha-0000000

# Where `make login` authenticates. ghcr.io for GitHub packages, docker.io for
# Docker Hub.
REGISTRY=ghcr.io

# Your GitHub username (NOT the org) and a Personal Access Token with the
# read:packages scope. A classic PAT; fine-grained tokens cannot read packages
# at the time of writing.
#
# Leave REGISTRY_TOKEN empty here and export it for the one `make login` call
# if you would rather it never touch disk:
#     REGISTRY_TOKEN=ghp_xxx make login
# A public package needs no login at all.
REGISTRY_USERNAME=
REGISTRY_TOKEN=

# Pull the image before every deploy even when the tag has not changed. Leave
# at 1: a retagged or re-pushed image is otherwise invisible.
DEPLOY_PULL=1
# Take a database backup before every deploy, before migrations run. This is
# the difference between a bad migration being a ten-minute restore and being
# an incident. Turn it off only if you have PITR.
DEPLOY_BACKUP=1
# Run `migrate --force` as part of deploy.
DEPLOY_MIGRATE=1
# Seconds `make deploy` waits for every container to report healthy before it
# calls the deploy failed and tells you how to roll back.
DEPLOY_TIMEOUT=180

# -----------------------------------------------------------------------------
#  RESOURCE BUDGET  —  RAM
# -----------------------------------------------------------------------------
#  STACK_MEM_LIMIT is the total this stack may use. It is not enforced by
#  docker directly: docker has no notion of a limit across services. It is
#  enforced by `scripts/preflight.sh`, which adds the six per-service limits
#  below and REFUSES TO START if the sum exceeds the budget. That turns "4 GB"
#  from a hope into an assertion that fails at the right time — before the
#  kernel OOM-kills postgres mid-write, which is the alternative.
#
#  Raising the budget is one line; raising it without raising a service limit
#  does nothing, which is the point.
STACK_MEM_LIMIT=4g

# The six limits. They sum to exactly 4096m — change one and change the budget
# or another limit to match, or preflight will say so.
PG_MEM_LIMIT=1024m
REDIS_MEM_LIMIT=768m
OCTANE_MEM_LIMIT=1024m
SCHEDULER_MEM_LIMIT=256m
QUEUE_IMPORTANT_MEM_LIMIT=512m
QUEUE_DEFAULT_MEM_LIMIT=512m

# CPU is a share, not a budget: these may sum past the core count and usually
# should, or an idle service's reservation is wasted.
PG_CPU_LIMIT=1.5
REDIS_CPU_LIMIT=1.0
OCTANE_CPU_LIMIT=1.5
SCHEDULER_CPU_LIMIT=0.5
QUEUE_CPU_LIMIT=0.5

# -----------------------------------------------------------------------------
#  RESOURCE BUDGET  —  DISK
# -----------------------------------------------------------------------------
#  Read `docs/operations.md` → "The 40 GB is a budget, not a wall" before
#  trusting this. Short version: docker CANNOT cap the size of a bind mount on
#  the usual overlay2/ext4 host. Anyone who tells you `storage_opt: size` does
#  it is describing devicemapper or XFS with pquota, neither of which is what
#  you are running. A real hard cap needs a dedicated filesystem — the docs
#  show the LVM and XFS-project-quota recipes.
#
#  What IS enforced, by `scripts/disk-guard.sh` on a cron:
#    • every tree is measured against its own sub-budget
#    • at STORAGE_WARN_PCT the guard warns and runs backup retention
#    • at 100% it runs retention, re-measures, and alerts if still over
#    • it NEVER deletes anything outside backups/ — not one file
#  A full disk is an outage. Deleting the database to avoid an outage is worse,
#  so the guard is allowed to fail loudly and is not allowed to fix it.
STACK_STORAGE_LIMIT=40g

# The four sub-budgets. They sum to 40g.
PG_STORAGE_BUDGET=20g
STORAGE_STORAGE_BUDGET=12g
BACKUP_STORAGE_BUDGET=6g
REDIS_STORAGE_BUDGET=2g

# Warn and start trimming backups at this percentage of a budget.
STORAGE_WARN_PCT=80

# Container logs are the other way a disk fills, and json-file logs default to
# UNBOUNDED. 10m × 3 × 6 services = 180 MB ceiling, outside the budgets above
# because docker keeps them under /var/lib/docker.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# -----------------------------------------------------------------------------
#  WHERE THE DATA LIVES
# -----------------------------------------------------------------------------
#  Every stateful path is a BIND MOUNT inside this repository, never a named
#  volume. `docker volume prune`, `docker system prune --volumes` and
#  `make prune` all operate on volumes; a bind mount is an ordinary directory
#  and is outside their reach. `make prune` measures these four trees before
#  and after and fails if any shrank.
#
#  Relative paths are resolved against this repository. Point them at a
#  mounted disk if you have one — an absolute path works and is the right
#  answer on a server whose root filesystem is small.
DATA_PG_DIR=./data/postgres
DATA_REDIS_DIR=./data/redis
DATA_STORAGE_DIR=./data/storage
BACKUP_DIR=./backups

# The application's environment file, mounted read-only at /app/.env. The app
# must never rewrite its own configuration, and a container restart must never
# lose an operator's edit.
APP_ENV_FILE=./config/app.env

# The group that owns the app-writable trees. Containers run as uid 33 and you
# are not uid 33, so a shared GROUP is what lets both write — see the comment
# in scripts/preflight.sh. Set this to YOUR gid: `id -g`.
HOST_GID=1000

# -----------------------------------------------------------------------------
#  BACKUPS
# -----------------------------------------------------------------------------
#  Targets: db | redis | files | config.  `make backup` takes all four.
#
#  RETENTION, and why it has three dials instead of one. "Delete backups older
#  than N days" deletes every backup you have the first time a cron sits broken
#  for N+1 days — the exact moment you need one. So:
#    RETENTION_DAYS     the age at which an artifact MAY be deleted
#    RETENTION_MIN      how many newest-per-target are kept whatever their age
#    BACKUP_STORAGE_BUDGET (above) the size ceiling that forces early trimming
#  An artifact is deleted only when it is older than RETENTION_DAYS AND is not
#  among the newest RETENTION_MIN of its target. The newest artifact of each
#  target is never deleted, at any age, for any reason.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MIN=7

# gzip is everywhere and safe. zstd is ~3× faster at a better ratio and is
# used automatically when the binary exists; set this to gzip to force it.
BACKUP_COMPRESSOR=auto

# pg_dump jobs for the directory format. 1 keeps the single-file custom format,
# which is simpler to move around; >1 is much faster on a large database and
# produces a directory. Keep 1 unless a dump is measured in hours.
BACKUP_PG_JOBS=1

# Verify every artifact after writing it: checksum recorded, and the dump's
# table of contents actually read back. Costs a few seconds and is the only
# thing standing between you and discovering a corrupt backup during a
# restore. Leave it on.
BACKUP_VERIFY=1

# Run after a successful/failed backup. "$1" is ok|fail, "$2" is the message.
# Anything executable: a curl to a Slack webhook, a mail call, a healthchecks.io
# ping. Silence is the default and silence is how a broken cron goes unnoticed
# for a month — set one.
#   BACKUP_NOTIFY_CMD=/usr/local/bin/notify-backup
BACKUP_NOTIFY_CMD=

# Off-site copy. A backup on the same disk as the database is not a backup; it
# survives a bad migration and nothing else. Set a destination and
# `make backup-sync` (and the cron) mirrors the backup directory to it.
# Anything rclone can address, or an rsync target.
#   BACKUP_SYNC_TARGET=r2:otc-backups/prod
#   BACKUP_SYNC_TARGET=backup@10.0.0.9:/srv/otc
BACKUP_SYNC_TARGET=
BACKUP_SYNC_CMD=rclone

# -----------------------------------------------------------------------------
#  CRON  —  schedules live here, `make cron-install` writes them
# -----------------------------------------------------------------------------
#  Standard five-field crontab, in TZ above. Empty disables that entry.
#  `make cron-install` renders these into the invoking user's crontab between
#  managed markers; `make cron-status` shows what is installed AND when each
#  job last actually succeeded, which is the number that matters.
#
#  Staggered on purpose: a db dump and an rdb copy at the same minute contend
#  for the same disk, and retention must run after the backups it prunes.
BACKUP_CRON_DB=0 2 * * *
BACKUP_CRON_REDIS=20 2 * * *
BACKUP_CRON_FILES=40 2 * * 0
BACKUP_CRON_CONFIG=50 2 * * *
BACKUP_CRON_RETENTION=30 4 * * *
BACKUP_CRON_SYNC=0 5 * * *
DISK_GUARD_CRON=*/30 * * * *

# Fail a backup that runs longer than this rather than letting two cron runs
# overlap on the same database. (They cannot overlap — there is a lock — but a
# hung one holding the lock silently skips every later run.)
BACKUP_TIMEOUT=3600

# -----------------------------------------------------------------------------
#  POSTGRES
# -----------------------------------------------------------------------------
#  Credentials are NOT here. They come from config/app.env — the file the
#  application connects with — so postgres is created with exactly the values
#  the app later logs in with and the two cannot drift.
POSTGRES_VERSION=18-alpine

# Sized against PG_MEM_LIMIT=1024m: shared_buffers ~25% of the container,
# effective_cache_size ~75%. Raise both together if you raise the limit.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
# Log statements slower than this many ms. 2000 is quiet enough for production
# and still catches the query that will eventually page you.
PG_LOG_MIN_DURATION=2000
POSTGRES_INITDB_ARGS=--data-checksums

# Not published by default: the app reaches postgres by service name on the
# project network, and `make db-shell` uses `docker exec`. When you do publish
# it, it is loopback-only and on a non-standard port so it cannot collide with
# a postgres already on 5432.
PG_BIND=127.0.0.1
PG_PUBLISHED_PORT=55432

# -----------------------------------------------------------------------------
#  REDIS
# -----------------------------------------------------------------------------
#  The full configuration is config/redis/redis.conf, mounted read-only. Only
#  the values that differ per host are here, passed as command-line overrides.
REDIS_VERSION=8-alpine

# Keep this well under REDIS_MEM_LIMIT (768m). maxmemory caps the DATASET;
# the process also needs room for client buffers, replication buffers and the
# copy-on-write fork during BGSAVE, which on a write-heavy instance can
# briefly approach the dataset size again. A container limit at ~1.5× maxmemory
# is the usual rule, and being wrong here means the kernel kills redis rather
# than redis evicting a key.
REDIS_MAXMEMORY=512mb

# volatile-lru is load-bearing, not a preference: it evicts only keys that
# carry a TTL. Queued jobs carry none, so eviction can never take queued work;
# cache entries all carry one, so they are always reclaimable. An allkeys-*
# policy on this shared instance starts deleting jobs when memory fills.
REDIS_MAXMEMORY_POLICY=volatile-lru

# Flipped to `no` for exactly one boot by `make restore TARGET=redis`, which
# needs redis to load an RDB rather than an existing AOF. Never set it by hand:
# DB 0 holds queued jobs and the slow lane runs --tries=1, so a job lost in a
# restart is not retried, it is gone.
REDIS_APPENDONLY=yes

REDIS_BIND=127.0.0.1
REDIS_PUBLISHED_PORT=56379

# -----------------------------------------------------------------------------
#  APPLICATION
# -----------------------------------------------------------------------------
# The port octane publishes on the host. nginx is NOT in this stack — it is a
# native install on the host proxying to this port. Loopback-bound so the app
# is reachable only through nginx, never straight off the network.
OCTANE_BIND=127.0.0.1
OCTANE_PORT=8050
OCTANE_WORKERS=6
OCTANE_MAX_REQUESTS=250

# The URL `make health` curls to prove the edge reaches the app. Empty skips
# that check — leave it empty anywhere nginx is not installed, or health
# reports a failure for a tier that was never meant to be there.
#   HEALTH_EDGE_URL=https://otc.example.com/up
HEALTH_EDGE_URL=
